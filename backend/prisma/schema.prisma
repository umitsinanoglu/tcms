// Prisma Schema for Test Case Management System (TCMS) - Jira Ready MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TestType {
  WEB
  DESKTOP
  IOS
  ANDROID
  API
  MOBILE
  MANUAL
  PERFORMANCE
  OTHER
}

enum DefectSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  WONT_FIX
}

enum Priority {
  BLOCKER
  CRITICAL
  NORMAL
  LOW
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  ARCHIVED  // Onaylandı / Tamamen kilitli — audit trail koruması
}

enum ResultStatus {
  PASSED
  FAILED
  SKIPPED
  BLOCKED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Role {
  ADMIN
  TEST_LEAD
  TESTER
  AUTOMATION_ENGINEER
  VIEWER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       Role     @default(TESTER)
  department String?
  avatarUrl  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

model Project {
  id             String     @id @default(uuid())
  name           String
  key            String     @unique
  description    String?
  jiraProjectKey String?
  createdAt      DateTime   @default(now())

  testPlans      TestPlan[]
  suites         Suite[]
  testCases      TestCase[]
  testRuns       TestRun[]
  defects        Defect[]
  sequences      ProjectSequence[]

  @@map("projects")
}

model ProjectSequence {
  id         String   @id @default(uuid())
  projectId  String
  entityType String   // "TC" | "DEF" | "RUN"
  lastValue  Int      @default(0)
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityType])
  @@map("project_sequences")
}

model TestPlan {
  id           String     @id @default(uuid())
  title        String
  description  String?
  version      String     @default("v1.0.0")
  environment  String     @default("STAGING")
  status       PlanStatus @default(ACTIVE)
  scope        String?
  requirements String?

  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testRuns     TestRun[]
  cases        TestPlanCase[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId, status])
  @@map("test_plans")
}

model TestPlanCase {
  id         String   @id @default(uuid())
  testPlanId String
  testCaseId String
  createdAt  DateTime @default(now())

  testPlan   TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testPlanId, testCaseId])
  @@index([testPlanId])
  @@index([testCaseId])
  @@map("test_plan_cases")
}

model Suite {
  id         String     @id @default(uuid())
  name       String
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId   String?
  parent     Suite?     @relation("SuiteToSuite", fields: [parentId], references: [id], onDelete: Cascade)
  children   Suite[]    @relation("SuiteToSuite")

  cases      TestCase[]
  orderIndex Int        @default(0)

  @@index([projectId, parentId, orderIndex])
  @@map("suites")
}

model TestCase {
  id           String       @id @default(uuid())
  code         String       @unique
  title        String
  description  String?
  executionType String      @default("MANUAL")
  type         TestType     @default(WEB)
  priority     Priority     @default(NORMAL)
  precondition String?

  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  suiteId      String?
  suite        Suite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  steps        TestStep[]
  results      TestResult[]
  defects      Defect[]
  testPlanCases TestPlanCase[]

  // Jira Ready
  jiraStoryKey String?
  jiraIssueUrl String?

  screenshotUrl String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId, suiteId])
  @@index([projectId, type])
  @@index([projectId, priority])
  @@index([createdAt])
  @@map("test_cases")
}

model TestStep {
  id             String   @id @default(uuid())
  stepNumber     Int
  action         String
  expectedResult String
  attachments    Json?    @default("[]")

  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId, stepNumber])
  @@map("test_steps")
}

model TestRun {
  id          String     @id @default(uuid())
  title       String
  version     String
  environment String
  status      RunStatus  @default(IN_PROGRESS)

  executedBy  String
  testerEmail String

  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testPlanId  String?
  testPlan    TestPlan?  @relation(fields: [testPlanId], references: [id], onDelete: SetNull)

  results     TestResult[]
  defects     Defect[]

  createdAt   DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([testPlanId])
  @@map("test_runs")
}

model TestResult {
  id           String       @id @default(uuid())

  testRunId    String
  testRun      TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testCaseId   String
  testCase     TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  status       ResultStatus

  executionMs  Int?
  errorMessage String?

  executedBy   String?
  testerEmail  String?

  // Extended Execution Metadata (Platform, Device, User Profile, Flaky, etc.)
  environment  String?
  platform     String?
  appVersion   String?
  device       String?
  userProfile  String?
  customerType String?
  flakyStatus  String?
  retries      Int?         @default(0)

  // Jira Ready
  jiraBugKey   String?
  jiraBugUrl   String?

  screenshotUrl String?

  defects      Defect[]

  executedAt   DateTime     @default(now())

  @@index([testRunId, status])
  @@index([testCaseId, executedAt])
  @@index([status])
  @@index([executedAt])
  @@map("test_results")
}

model Defect {
  id              String         @id @default(uuid())
  key             String         @unique // e.g. DEF-101
  title           String
  description     String?
  severity        DefectSeverity @default(MAJOR)
  status          DefectStatus   @default(OPEN)

  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId      String?
  testCase        TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  testRunId       String?
  testRun         TestRun?       @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testResultId    String?
  testResult      TestResult?    @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  assignedTo      String?
  reportedBy      String?
  environment     String?        @default("STAGING")
  channel         String?        @default("WEB")

  jiraBugKey      String?
  jiraBugUrl      String?

  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId, status, severity])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([testResultId])
  @@index([createdAt])
  @@map("defects")
}



